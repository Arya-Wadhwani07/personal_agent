# I fill this template only for class-only synthetic accounts; never commit real values.
API_SERVER_KEY=REPLACE_WITH_RANDOM_KEY_AT_LEAST_32_CHARACTERS
A3_INTERNAL_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_KEY_AT_LEAST_32_CHARACTERS
# Hermes browser OAuth is my primary path; api_key is an optional paid mode.
A3_PRIMARY_AUTH=oauth
# Real provider key stays separate from Hermes internal OPENAI_API_KEY.
A3_OPENAI_API_KEY=
A3_OPENAI_MODEL=
A3_PAID_CALLS=false
A3_SIMULATE_PRIMARY_429=false
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
OLLAMA_MODEL=gemma4:e2b
# Local Docker development only. Cloud must use the laptop tailnet address and proxy.
OLLAMA_URL=http://host.docker.internal:11434/api/chat
OLLAMA_PROXY=
A3_SIMULATE_429=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Enable only after verifying dedicated class-only synthetic mailbox contents.
A3_EMAIL_ENABLED=false
EMAIL_ALLOWLIST=
TAVILY_API_KEY=
A3_STATE_BUCKET=
A3_STATE_DIR=/state
HERMES_HOME=/state/hermes

# Cloud-only, class-only tagged Tailscale enrollment; leave empty for local Docker.
TS_AUTHKEY=

# Lifetime call quotas, persisted with state; failed/uncertain calls consume quota.
A3_SEARCH_CALL_LIMIT=0
A3_NVIDIA_CALL_LIMIT=0
A3_OPENAI_CALL_LIMIT=0
